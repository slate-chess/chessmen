{
  "name": "chessmen",
  "version": "0.5.0",
  "description": "Chessboard for the web: replay PGN games, show FEN diagrams, with animated moves, arrows and variations. One script tag, no dependencies, no build step.",
  "homepage": "https://slatechess.com/opensource/chessmen/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slate-chess/chessmen.git"
  },
  "bugs": {
    "url": "https://github.com/slate-chess/chessmen/issues"
  },
  "keywords": [
    "chess",
    "chessboard",
    "chess-board",
    "chess-pieces",
    "chessmen",
    "pgn",
    "pgn-viewer",
    "pgn-parser",
    "replay",
    "fen",
    "diagram",
    "chess-game",
    "board",
    "svg",
    "animation",
    "variations",
    "widget",
    "embed",
    "zero-dependency"
  ],
  "type": "module",
  "main": "dist/chessmen.mjs",
  "module": "dist/chessmen.mjs",
  "browser": "dist/chessmen.js",
  "exports": {
    ".": {
      "import": "./dist/chessmen.mjs",
      "default": "./dist/chessmen.js"
    },
    "./src": "./src/index.js",
    "./all": "./dist/chessmen.all.js",
    "./chessmen.css": "./dist/chessmen.css",
    "./pieces/*": "./dist/pieces/*"
  },
  "files": [
    "dist/",
    "src/",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "examples/"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test",
    "prepublishOnly": "npm test",
    "pieces": "python3 tools/build_pieces.py",
    "copy": "node tools/copy-dist.mjs",
    "readme-image": "node tools/readme-image.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "Turtle Leap LLC (https://slatechess.com)",
  "license": "Apache-2.0"
}
