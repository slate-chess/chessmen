{
  "name": "pgn-replay",
  "version": "0.5.0",
  "description": "Embed a PGN replay on any web page: one script tag, zero dependencies. Animated moves, arrows, variations, FEN diagrams and 20 board themes. A chess PGN viewer and chessboard that needs no build step. LLM-friendly (llms.txt).",
  "homepage": "https://slatechess.com/opensource/pgn-replay-demo.html",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slate-chess/pgn-replay.git"
  },
  "bugs": {
    "url": "https://github.com/slate-chess/pgn-replay/issues"
  },
  "keywords": [
    "pgn",
    "pgn-replay",
    "pgn-viewer",
    "chess",
    "chessboard",
    "chess-board",
    "fen",
    "diagram",
    "replay",
    "animation",
    "variations",
    "svg"
  ],
  "type": "module",
  "main": "dist/pgn-replay.mjs",
  "module": "dist/pgn-replay.mjs",
  "browser": "dist/pgn-replay.js",
  "exports": {
    ".": {
      "import": "./dist/pgn-replay.mjs",
      "default": "./dist/pgn-replay.js"
    },
    "./src": "./src/index.js",
    "./all": "./dist/pgn-replay.all.js",
    "./pgn-replay.css": "./dist/pgn-replay.css",
    "./pieces/*": "./dist/pieces/*"
  },
  "files": [
    "dist/",
    "src/",
    "llms.txt",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "examples/"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node tools/build.mjs && node --test 'test/*.test.js'",
    "pieces": "python3 tools/build_pieces.py",
    "copy": "node tools/copy-dist.mjs",
    "readme-image": "node tools/readme-image.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "author": "Turtle Leap LLC (https://slatechess.com)",
  "license": "Apache-2.0"
}
